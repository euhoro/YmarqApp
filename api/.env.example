# Copy to .env.local (git-ignored). Vercel sets these per environment (#31).

# Storage: memory (default, data lost on restart) | postgres (#32)
STORE=memory
# Neon Postgres connection string (set by the Vercel Neon integration, #31)
DATABASE_URL=

# Comma-separated origins allowed to call the API from a browser; * for any (default)
CORS_ORIGINS=*
