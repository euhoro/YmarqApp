{
  "name": "ymarq-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ymarq API: Hono on Vercel Functions",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run format:check && npm test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.45.3",
    "expo-server-sdk": "^7.2.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.3",
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
