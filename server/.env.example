# Copy to .env.local (git-ignored). Vercel sets these per environment (#31).

# Storage: memory (default, data lost on restart) | postgres (#32)
STORE=memory
# Neon Postgres connection string (set by the Vercel Neon integration, #31)
DATABASE_URL=

# Comma-separated origins allowed to call the API from a browser; * for any (default)
CORS_ORIGINS=*

# Sign-in tokens: firebase (default, real Firebase ID tokens) | dev (also accepts `Bearer dev:<userId>`;
# refused when VERCEL_ENV=production). Use dev locally and with the app's fake auth.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=ymarq-35862

# Vercel build only (scripts/db-deploy.ts): add sample listings when the products table is empty.
SEED_SAMPLE_DATA=false

# Photo uploads (POST /v1/uploads, #35): Vercel Blob read-write token. Set automatically when a Blob store
# is connected to the Vercel project; locally copy it with `vercel env pull`. handleUpload signs client
# tokens with it (OIDC / BLOB_STORE_ID is not enough for client uploads). Without it the route answers 503.
BLOB_READ_WRITE_TOKEN=
