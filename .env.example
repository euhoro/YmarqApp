# Copy to .env.local (git-ignored) and adjust.

# Where products come from: fake (default) | api (the Ymarq server) | legacy (2014 GetProducts route)
EXPO_PUBLIC_DATA_SOURCE=fake

# The Ymarq server (used when EXPO_PUBLIC_DATA_SOURCE=api), e.g. http://localhost:3001 for `npm --prefix server run dev`
EXPO_PUBLIC_API_URL=

# Sign-in: fake (default; any number, code 123456) | firebase (real SMS via Firebase; web only for now)
EXPO_PUBLIC_AUTH=fake

# Fake auth: start signed in (default) or signed out (false) to try the sign-in screen.
EXPO_PUBLIC_FAKE_AUTH_SIGNED_IN=true

# Base URL of the revived legacy backend (only used when EXPO_PUBLIC_DATA_SOURCE=legacy).
# The app calls GET {url}/photos/GetProducts/{userCode}
EXPO_PUBLIC_LEGACY_API_URL=

# Firebase web app config (Firebase console → Project settings → Your apps → Web).
# These values are public identifiers, not secrets.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=ymarq-35862
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=ymarq-35862.firebaseapp.com
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
